{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js --max-warnings=0",
        "format:check": "prettier --check \"resources/**/*.{ts,vue,css}\" \"*.{json,js,ts}\"",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:build": "vite build && playwright test",
        "typecheck": "vue-tsc --noEmit",
        "electron:dev": "electron electron/main.cjs",
        "electron:build": "electron-builder"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@intlify/devtools-types": "^11.4.6",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/vite": "^4.0.0",
        "@typescript-eslint/eslint-plugin": "^8.63.0",
        "@typescript-eslint/parser": "^8.63.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "axios": "^1.18.1",
        "concurrently": "^9.0.1",
        "eslint": "^10.6.0",
        "eslint-plugin-vue": "^10.9.2",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.5",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.7.3",
        "typescript-eslint": "^8.63.0",
        "vite": "^7.0.7",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.7"
    },
    "dependencies": {
        "pinia": "^3.0.4",
        "vite-plugin-pwa": "^1.3.0",
        "vue": "^3.5.39",
        "vue-i18n": "^11.1.12",
        "vue-router": "^4.6.4"
    }
}
