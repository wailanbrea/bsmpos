# Dependencies and generated assets
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage
/.tools/

# Environment and application secrets
.env
.env.*
!.env.example
/.env.backup
/.env.production

# Laravel runtime artifacts
/bootstrap/cache/*.php
/storage/*.key
/storage/pail/
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/phpstan/
/storage/framework/views/*
!/storage/framework/views/.gitignore

# Tooling and local editor state
/.playwright-cli/
/.phpunit.result.cache
/.phpunit.cache/
/.idea/
/.vscode/
*.log
*.local
Thumbs.db

# Graphify cache and intermediate extraction batches
/graphify-out/cache/
/graphify-out/.graphify_*
/graphify-out/*/
